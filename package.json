{
  "name": "@email-utils/classifier",
  "version": "1.0.0-rc.4",
  "description": "Classify email addresses: mailbox provider, disposable domains, role accounts, and typo suggestions.",
  "keywords": [
    "email",
    "disposable-email",
    "email-provider",
    "role-account",
    "typo",
    "classifier"
  ],
  "homepage": "https://email-utils.github.io/meta/",
  "bugs": {
    "url": "https://github.com/email-utils/classifier/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/email-utils/classifier.git"
  },
  "license": "MIT",
  "author": "Marwynn Joynes",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./providers": {
      "import": "./dist/providers.mjs",
      "require": "./dist/providers.cjs"
    },
    "./sources": {
      "import": "./dist/sources.mjs",
      "require": "./dist/sources.cjs"
    },
    "./disposable": {
      "import": "./dist/disposable.mjs",
      "require": "./dist/disposable.cjs"
    },
    "./classify": {
      "import": "./dist/classify.mjs",
      "require": "./dist/classify.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "npm run build && vitest bench --run",
    "api": "npm run build && node scripts/api-report.ts",
    "update:disposable": "node scripts/update-disposable.mjs",
    "check:package": "publint && attw --pack . --profile node16 && size-limit && node scripts/import-cost.ts && node scripts/api-report.ts --check",
    "pre-commit": "npm run lint && npm run format:check && npm run typecheck",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.59.3",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "fast-check": "^4.10.2",
    "lefthook": "^2.1.14",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "lefthook": true
  },
  "dependencies": {
    "@email-utils/validator-syntax": "^1.0.0-rc.4"
  }
}
